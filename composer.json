{
    "name": "setono/editorjs-bundle",
    "description": "Symfony bundle that integrates the editorjs-php library",
    "license": "MIT",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "Joachim Løvgaard",
            "email": "joachim@loevgaard.dk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "setono/editorjs-php": "^1.2",
        "symfony/config": "^6.4 || ^7.4 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.4 || ^8.0",
        "symfony/string": "^6.4 || ^7.4 || ^8.0",
        "symfony/twig-bundle": "^6.4 || ^7.4 || ^8.0",
        "twig/twig": "^3.5"
    },
    "require-dev": {
        "matthiasnoback/symfony-dependency-injection-test": "^4.3 || ^5.1 || ^6.3",
        "setono/code-quality-pack": "^3.3"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\EditorJSBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Setono\\EditorJSBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "psalm",
        "check-style": "ecs check",
        "fix-style": "ecs check --fix",
        "phpunit": "phpunit"
    }
}
