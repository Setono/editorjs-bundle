{
    "name": "setono/editorjs-bundle",
    "description": "Symfony bundle that integrates the editorjs-php library",
    "license": "MIT",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "Joachim Løvgaard",
            "email": "joachim@loevgaard.dk"
        }
    ],
    "require": {
        "php": ">=8.1",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "setono/editorjs-php": "^1.2",
        "symfony/config": "^5.4 || ^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0 || ^8.0",
        "symfony/string": "^5.4 || ^6.4 || ^7.0 || ^8.0",
        "symfony/twig-bundle": "^5.4 || ^6.4 || ^7.0 || ^8.0",
        "twig/twig": "^2.15 || ^3.5"
    },
    "require-dev": {
        "infection/infection": "^0.27.11",
        "matthiasnoback/symfony-dependency-injection-test": "^4.3 || ^5.1",
        "phpspec/prophecy-phpunit": "^2.3",
        "phpunit/phpunit": "^9.6",
        "psalm/plugin-phpunit": "^0.18",
        "psalm/plugin-symfony": "^5.2",
        "setono/code-quality-pack": "^2.9",
        "shipmonk/composer-dependency-analyser": "^1.8.2"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\EditorJSBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Setono\\EditorJSBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "psalm",
        "check-style": "ecs check",
        "fix-style": "ecs check --fix",
        "phpunit": "phpunit"
    }
}
